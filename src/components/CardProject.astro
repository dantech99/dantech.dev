---
import Nextjs from '@/icons/Nextjs.astro';
import Supabase from '@/icons/Supabase.astro';
import Laravel from '@/icons/Laravel.astro';
import Mysql from '@/icons/Mysql.astro';
import Link from '@/icons/Link.astro';
import Js from '@/icons/js.astro';
import Tailwind from '@/icons/tailwindscss.astro';
import Php from '@/icons/php.astro';
import React from '@/icons/reactjs.astro';
import CodeSvg from '@/icons/CodeSvg.astro';
import Nodejs from '@/icons/Nodejs.astro';
import Astro from '@/icons/AstroIcon.astro';

const iconComponents = {
  Nextjs,
  Supabase,
  Laravel,
  Tailwind,
  Mysql,
  Link,
  Js,
  CodeSvg,
  Php,
  React,
  Nodejs,
  Astro
};

interface LinkItem {
  name: string;
  url: string;
  icon: string;
}
interface TechItem {
  name: string;
  icon: string;
}

const {
  title,
  description,
  img,
  tags = [] as string[],
  links = [] as LinkItem[],
  tech = [] as TechItem[],
  slug,
  status = 'Completado',
  date,
} = Astro.props;

const year = date ? new Date(date).getFullYear() : null;
const dot =
  status === 'Completado'
    ? 'bg-emerald-500'
    : status === 'En desarrollo'
      ? 'bg-amber-500'
      : 'bg-ink-muted';
---

<article
  class="flex h-full w-full flex-col gap-3 rounded-[20px] border border-line bg-surface p-2.5 shadow-elevated"
>
  <a
    href={`/projects/${slug}`}
    class="group block aspect-[4/3] overflow-hidden rounded-xl bg-soft"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={img}
      alt=""
      class="size-full object-cover object-top transition duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      loading="lazy"
      onerror="this.style.display='none'"
    />
  </a>

  <div class="flex flex-1 flex-col gap-3 px-1.5 pb-1.5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2">
      <h3 class="text-base font-medium text-ink">
        <a href={`/projects/${slug}`} class="hover:underline">{title}</a>
      </h3>
      <div class="flex items-center gap-3">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-soft px-3 py-1 text-xs text-ink"
          aria-label={`Estado del proyecto: ${status}`}
        >
          <span class={`size-1.5 rounded-full ${dot}`} aria-hidden="true"></span>
          {status}
        </span>
        {year && <span class="text-xs text-ink-muted">{year}</span>}
      </div>
    </div>

    <p class="text-pretty text-sm leading-relaxed text-ink-muted">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <span class="rounded-full bg-soft px-3 py-1 text-xs capitalize text-ink">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {
      tech.length > 0 && (
        <ul
          role="list"
          class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-ink-muted"
        >
          {tech.map(({ name, icon }: TechItem) => {
            const IconComponent =
              iconComponents[icon as keyof typeof iconComponents];
            return (
              <li class="flex items-center gap-1.5">
                {IconComponent && <IconComponent class="size-4 icon" />}
                {name}
              </li>
            );
          })}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-2 pt-1">
          {links.map(({ name, url, icon }: LinkItem) => {
            const IconComponent =
              iconComponents[icon as keyof typeof iconComponents];
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium text-ink transition hover:-translate-y-0.5"
              >
                {IconComponent && (
                  <IconComponent class="size-4 fill-current text-ink" />
                )}
                {name}
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</article>
