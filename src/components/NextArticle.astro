---
import { getEntry } from 'astro:content';
import SiteCard from '@/components/SiteCard.jsx';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const nextArticle = await getEntry('articles', slug);
---

{
  nextArticle && (
    <SiteCard
      client:visible
      padding="0"
      className="transition duration-200 hover:-translate-y-0.5"
    >
    <a
      href={`/blog/${nextArticle.slug}`}
      class="group flex items-center justify-between gap-4 px-6 py-5 no-underline"
    >
      <div class="flex flex-col gap-1">
        <span class="text-xs font-medium text-ink-muted">
          Siguiente lectura
        </span>
        <span class="text-balance text-lg font-medium leading-snug text-ink">
          {nextArticle.data.title}
        </span>
      </div>

      <svg
        class="shrink-0 text-ink transition-transform duration-200 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        fill="none"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          fill-rule="evenodd"
          d="M13.155 16.834a.714.714 0 001.006-.091l3.564-4.277a.711.711 0 000-.932L14.16 7.257a.714.714 0 00-1.097.915l2.565 3.078H7.9a.75.75 0 000 1.5h7.73l-2.565 3.078a.714.714 0 00.091 1.006z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
    </SiteCard>
  )
}
