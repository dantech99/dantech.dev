---
import { getEntry } from 'astro:content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const nextArticle = await getEntry('articles', slug);
---

{
  nextArticle && (
    <a
      href={`/blog/${nextArticle.slug}`}
      class="group flex flex-col md:flex-row md:items-center justify-between gap-3 rounded-lg border border-gray-600 bg-gradient-to-r from-gray-800 to-black px-5 py-4 no-underline hover:scale-[1.01] duration-200 hover:border-gray-800 hover:from-black hover:to-gray-900">
      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-wide text-gray-400">
          Siguiente lectura
        </span>
        <span class="text-lg font-semibold text-white">
          {nextArticle.data.title}
        </span>
      </div>

      <svg
        class="shrink-0 self-end md:self-center transition-transform duration-200 group-hover:translate-x-1"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        fill="none">
        <path
          fill="#fff"
          fill-rule="evenodd"
          d="M13.155 16.834a.714.714 0 001.006-.091l3.564-4.277a.711.711 0 000-.932L14.16 7.257a.714.714 0 00-1.097.915l2.565 3.078H7.9a.75.75 0 000 1.5h7.73l-2.565 3.078a.714.714 0 00.091 1.006z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  )
}
