---
import SiteCard from "@/components/SiteCard.jsx";

interface Props {
  title: string;
  description: string;
  author: string;
  slug: string;
  img?: string;
}

const { title, description, author, slug, img } = Astro.props;
---

<SiteCard
  client:visible
  padding="0"
  className="h-full transition duration-200 hover:-translate-y-0.5"
>
<a
  href={`/blog/${slug}`}
  class="group flex h-full flex-col gap-3 p-2.5"
>
  {
    img && (
      <div class="aspect-[16/9] overflow-hidden rounded-xl bg-soft">
        <img
          src={img}
          alt=""
          class="size-full object-cover transition duration-500 group-hover:scale-105"
          loading="lazy"
          onerror="this.parentElement.style.display='none'"
        />
      </div>
    )
  }
  <div class="flex flex-col gap-2 px-1.5">
    <h3
      class="text-balance text-lg font-medium leading-snug text-ink"
      transition:name={`article-${title}`}
    >
      {title}
    </h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-ink-muted">
      {description}
    </p>
  </div>
  <div class="mt-auto flex flex-wrap items-center gap-2 px-1.5 pb-1.5">
    <span class="rounded-full bg-soft px-3 py-1 text-xs text-ink">Artículo</span>
    <span class="text-xs text-ink-muted">{author}</span>
  </div>
</a>
</SiteCard>
