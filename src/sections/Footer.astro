---
import { ArrowUp } from "lucide-react";
import SocialLinks from "@/components/SocialLinks.astro";
import { EMAIL, mailto } from "@/data/contact";
---

<footer class="mb-14 mt-10">
  <div
    class="mx-auto flex w-full flex-col gap-6 border-t border-line pb-6 pt-10 text-sm text-ink"
  >
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <a href={mailto("Contacto")} class="hover:underline">{EMAIL}</a>
      <p class="text-ink-muted">© 2026 Danilo Macea. Todos los derechos reservados.</p>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
      <SocialLinks />
      <a
        href="#inicio"
        data-scroll-top
        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-4 py-2 text-ink shadow-elevated transition hover:-translate-y-0.5"
      >
        Volver arriba <ArrowUp size={14} aria-hidden="true" />
      </a>
    </div>
  </div>
  <div class="md:hidden mt-10"></div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelector<HTMLAnchorElement>("[data-scroll-top]")
      ?.addEventListener("click", (event) => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
  });
</script>
