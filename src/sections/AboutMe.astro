---
import { getCollection } from "astro:content";
import { Asterisk } from "lucide-react";
import ArrowLink from "@/components/ArrowLink.astro";
import ProfileLanyard from "@/components/ProfileLanyard.jsx";

const certificates = (await getCollection("certificates")).sort(
  (a, b) => a.data.date.localeCompare(b.data.date),
);
const education = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);

interface ContactRow {
  label: string;
  value: string;
  href: string;
}

const contact: ContactRow[] = [
  {
    label: "email",
    value: "dantech.dev@hotmail.com",
    href: "mailto:dantech.dev@hotmail.com",
  },
  { label: "github", value: "dantech99", href: "https://github.com/dantech99" },
  {
    label: "linkedin",
    value: "in/dantech99",
    href: "https://linkedin.com/in/dantech99",
  },
  { label: "x", value: "@dantech99", href: "https://x.com/dantech99" },
  {
    label: "instagram",
    value: "@dantech.dev",
    href: "https://instagram.com/dantech.dev",
  },
  {
    label: "ubicación",
    value: "Sahagún, Córdoba",
    href: "https://maps.google.com/?q=Sahag%C3%BAn,+C%C3%B3rdoba,+Colombia",
  },
];

const stack: { label: string; value: string }[] = [
  { label: "Frontend", value: "React, Next.js, TypeScript, Tailwind CSS, Astro" },
  { label: "Backend", value: "Node.js, Elysia, PostgreSQL" },
  { label: "Infra", value: "Docker, Dokploy, VPS Linux" },
  { label: "Herramientas", value: "Git, Figma, Claude Code" },
];

const pillClass =
  "inline-flex w-fit items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,0.05)]";
const headingClass =
  "mt-5 max-w-[22ch] text-balance font-serif text-[34px] leading-[1.08] tracking-[-0.02em] text-ink md:text-[44px]";
const cardClass =
  "mt-6 overflow-hidden rounded-2xl border border-line bg-surface shadow-elevated";
const rowClass = "border-b border-line last:border-b-0";
---

<section
  id="sobre-mi"
  class="grid grid-cols-1 gap-12 pb-10 pt-10 md:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] md:gap-x-16 md:pt-16"
>
  <!-- Sidebar -->
  <aside class="flex flex-col self-start">
    <!-- tarjeta colgante interactiva (Lanyard de React Bits): se carga al ser visible -->
    <div class="relative -mx-2 h-[420px] md:h-[460px]">
      <ProfileLanyard
        client:visible
        frontImage="/img/perfil-card.jpg"
        backImage="/img/perfil-card-back.jpg"
        label="Foto de Danilo Macea en una tarjeta colgante"
      />
    </div>
    <p class="-mt-2 text-center text-xs text-ink-muted">
      Arrastra la tarjeta o haz clic para girarla
    </p>

    <h1
      class="mt-8 text-balance font-serif text-[44px] leading-[1.04] tracking-[-0.02em] text-ink"
    >
      Danilo Antonio Macea
    </h1>
    <p class="mt-3 text-sm text-ink-muted">full stack · freelance · CO</p>

    <p class="mt-6 text-base leading-relaxed text-ink-muted">
      Cerca de 4 años construyendo aplicaciones web. Actualmente freelance en
      e-commerce con Next.js, Node y PostgreSQL.
    </p>

    <ul class="mt-6 rounded-2xl border border-line bg-surface px-4 shadow-elevated" role="list">
      {
        contact.map(({ label, value, href }) => (
          <li class={rowClass}>
            <a
              href={href}
              target={href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="group grid grid-cols-[6rem_1fr_auto] items-center gap-3 py-3.5 text-ink transition-opacity hover:opacity-70"
            >
              <span class="text-xs capitalize text-ink-muted">{label}</span>
              <span class="truncate text-sm">{value}</span>
              <ArrowLink />
            </a>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-6 inline-flex w-fit items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-ink shadow-elevated"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-green-400 opacity-60"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-[#1E9E55]"></span>
      </span>
      disponible para nuevos proyectos
    </p>
  </aside>

  <!-- Main content -->
  <main class="flex flex-col gap-16">
    <!-- Sobre mí -->
    <article>
      <h2 class={pillClass}>
        <Asterisk size={12} strokeWidth={2.2} aria-hidden="true" />
        Sobre mí
      </h2>
      <p class={headingClass}>
        Diseño interfaces claras y las conecto con backends que aguantan.
      </p>
      <p class="mt-6 text-base leading-relaxed text-ink-muted md:text-lg">
        Trabajo desde Sahagún, Córdoba, para clientes en Colombia y remoto. Me
        muevo con soltura entre el frontend en React y TypeScript y el backend
        en Node, y me encargo también del despliegue en VPS con Docker.
        Prefiero soluciones simples que se puedan mantener a soluciones
        brillantes que nadie entiende.
      </p>
    </article>

    <!-- Stack -->
    <article>
      <h2 class={pillClass}>
        <Asterisk size={12} strokeWidth={2.2} aria-hidden="true" />
        Stack
      </h2>
      <p class={headingClass}>Con qué construyo.</p>
      <dl class={`${cardClass} px-4`}>
        {
          stack.map(({ label, value }) => (
            <div
              class={`${rowClass} grid grid-cols-1 gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:items-center sm:gap-4`}
            >
              <dt class="text-sm text-ink-muted">{label}</dt>
              <dd class="text-base text-ink">{value}</dd>
            </div>
          ))
        }
      </dl>
    </article>

    <!-- Certificados -->
    <article>
      <h2 class={pillClass}>
        <Asterisk size={12} strokeWidth={2.2} aria-hidden="true" />
        Certificados
      </h2>
      <p class={headingClass}>Aprendizaje continuo.</p>
      <ul class={`${cardClass} px-4`} role="list">
        {
          certificates.map(({ data }) => (
            <li class={rowClass}>
              <a
                href={data.url ?? data.image}
                target="_blank"
                rel="noopener noreferrer"
                class="group grid grid-cols-[4rem_1fr_auto] items-center gap-4 py-4 text-ink transition-opacity hover:opacity-70 sm:grid-cols-[4rem_1fr_auto_auto]"
              >
                <span class="flex h-12 w-16 items-center justify-center overflow-hidden rounded-lg border border-line bg-soft">
                  <img
                    src={data.image}
                    alt={`Certificado: ${data.title}`}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    width="64"
                    height="48"
                    onerror="this.remove()"
                  />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="truncate text-base">{data.title}</span>
                  {data.issuer && (
                    <span class="text-xs text-ink-muted sm:hidden">
                      {data.issuer}
                    </span>
                  )}
                </span>
                {data.issuer && (
                  <span class="hidden rounded-full bg-soft px-3 py-1 text-xs text-ink-muted sm:block">
                    {data.issuer}
                  </span>
                )}
                <ArrowLink />
              </a>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- Formación -->
    <article>
      <h2 class={pillClass}>
        <Asterisk size={12} strokeWidth={2.2} aria-hidden="true" />
        Formación
      </h2>
      <p class={headingClass}>Mi recorrido académico.</p>
      <ul class={`${cardClass} px-4`} role="list">
        {
          education.map(({ data }) => (
            <li
              class={`${rowClass} grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 py-4 sm:grid-cols-[1fr_auto_auto] sm:gap-x-8`}
            >
              <span class="text-base text-ink">{data.title}</span>
              <span class="col-start-1 text-xs text-ink-muted sm:col-start-auto sm:text-sm">
                {data.institution}
              </span>
              <span class="col-start-2 row-start-1 rounded-full bg-soft px-3 py-1 text-xs text-ink-muted sm:col-start-auto sm:row-start-auto">
                {data.year}
              </span>
            </li>
          ))
        }
      </ul>
    </article>
  </main>
</section>
