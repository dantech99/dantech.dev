---
import { getCollection } from "astro:content";
import ArrowLink from "@/components/ArrowLink.astro";

const certificates = (await getCollection("certificates")).sort(
  (a, b) => a.data.date.localeCompare(b.data.date),
);
const education = (await getCollection("education")).sort(
  (a, b) => a.data.order - b.data.order,
);

interface ContactRow {
  label: string;
  value: string;
  href: string;
}

const contact: ContactRow[] = [
  {
    label: "email",
    value: "dantech.dev@hotmail.com",
    href: "mailto:dantech.dev@hotmail.com",
  },
  { label: "github", value: "dantech99", href: "https://github.com/dantech99" },
  {
    label: "linkedin",
    value: "in/dantech99",
    href: "https://linkedin.com/in/dantech99",
  },
  { label: "x", value: "@dantech99", href: "https://x.com/dantech99" },
  {
    label: "instagram",
    value: "@dantech.dev",
    href: "https://instagram.com/dantech.dev",
  },
  {
    label: "ubicación",
    value: "Sahagún, Córdoba",
    href: "https://maps.google.com/?q=Sahag%C3%BAn,+C%C3%B3rdoba,+Colombia",
  },
];

const stack: { label: string; value: string }[] = [
  { label: "Frontend", value: "React, Next.js, TypeScript, Tailwind CSS, Astro" },
  { label: "Backend", value: "Node.js, Elysia, PostgreSQL" },
  { label: "Infra", value: "Docker, Dokploy, VPS Linux" },
  { label: "Herramientas", value: "Git, Figma, Claude Code" },
];

const labelClass =
  "font-mono text-xs uppercase tracking-wider text-text-secondary";
const rowBorder = "border-b border-border";
---

<section
  id="sobre-mi"
  class="grid grid-cols-1 gap-12 pt-10 md:grid-cols-[minmax(0,5fr)_minmax(0,8fr)] md:gap-x-20 md:pt-16"
>
  <!-- Sidebar -->
  <aside class="flex flex-col self-start md:sticky md:top-10">
    <div
      class="flex size-28 items-center justify-center rounded-xl border border-border bg-bg-secondary dark:bg-[#111420]"
      aria-hidden="true"
    >
      <span class="font-mono text-3xl text-primary dark:text-secondary">DM</span>
    </div>

    <h1 class="mt-8 text-3xl font-semibold tracking-tight text-text-primary">
      Danilo Antonio Macea
    </h1>
    <p class="mt-2 font-mono text-sm text-text-secondary">
      full stack · freelance · CO
    </p>

    <p class="mt-6 text-base leading-relaxed text-text-secondary">
      Cerca de 4 años construyendo aplicaciones web. Actualmente freelance en
      e-commerce con Next.js, Node y PostgreSQL.
    </p>

    <ul class="mt-6 border-t border-border" role="list">
      {
        contact.map(({ label, value, href }) => (
          <li class={rowBorder}>
            <a
              href={href}
              target={href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="group grid grid-cols-[6.5rem_1fr_auto] items-center gap-3 py-3.5 transition-colors hover:text-primary dark:hover:text-secondary"
            >
              <span class={labelClass}>{label}</span>
              <span class="truncate text-sm text-text-primary group-hover:text-inherit">
                {value}
              </span>
              <ArrowLink />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 flex items-center gap-2 font-mono text-xs text-text-secondary">
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-green-400 opacity-60"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
      </span>
      disponible para nuevos proyectos
    </p>
  </aside>

  <!-- Main content -->
  <main class="flex flex-col gap-16">
    <!-- 01 Sobre mí -->
    <article>
      <h2 class={`${labelClass} flex items-center gap-3`}>
        <span class="text-primary dark:text-secondary">01</span>
        <span>Sobre mí</span>
      </h2>
      <p
        class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-text-primary md:text-[2.5rem] md:leading-[1.1]"
      >
        Diseño interfaces claras y las conecto con backends que aguantan.
      </p>
      <p class="mt-6 text-base leading-relaxed text-text-secondary md:text-lg">
        Trabajo desde Sahagún, Córdoba, para clientes en Colombia y remoto. Me
        muevo con soltura entre el frontend en React y TypeScript y el backend
        en Node, y me encargo también del despliegue en VPS con Docker.
        Prefiero soluciones simples que se puedan mantener a soluciones
        brillantes que nadie entiende.
      </p>
    </article>

    <!-- 02 Stack -->
    <article>
      <h2 class={`${labelClass} flex items-center gap-3`}>
        <span class="text-primary dark:text-secondary">02</span>
        <span>Stack</span>
      </h2>
      <dl class="mt-4 border-t border-border">
        {
          stack.map(({ label, value }) => (
            <div
              class={`${rowBorder} grid grid-cols-1 gap-1 py-4 sm:grid-cols-[11.5rem_1fr] sm:items-center sm:gap-4`}
            >
              <dt class="font-mono text-sm text-text-secondary">{label}</dt>
              <dd class="text-base text-text-primary">{value}</dd>
            </div>
          ))
        }
      </dl>
    </article>

    <!-- 03 Certificados -->
    <article>
      <h2 class={`${labelClass} flex items-center gap-3`}>
        <span class="text-primary dark:text-secondary">03</span>
        <span>Certificados</span>
      </h2>
      <ul class="mt-4 border-t border-border" role="list">
        {
          certificates.map(({ data }) => (
            <li class={rowBorder}>
              <a
                href={data.url ?? data.image}
                target="_blank"
                rel="noopener noreferrer"
                class="group grid grid-cols-[4rem_1fr_auto] items-center gap-4 py-4 transition-colors hover:text-primary dark:hover:text-secondary sm:grid-cols-[4rem_1fr_auto_auto]"
              >
                <span class="flex h-12 w-16 items-center justify-center overflow-hidden rounded-md border border-dashed border-border-secondary/60 bg-bg-secondary dark:bg-[#111420]">
                  <img
                    src={data.image}
                    alt={`Certificado: ${data.title}`}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    width="64"
                    height="48"
                    onerror="this.remove()"
                  />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="truncate text-base text-text-primary group-hover:text-inherit">
                    {data.title}
                  </span>
                  {data.issuer && (
                    <span class="font-mono text-xs text-text-secondary sm:hidden">
                      {data.issuer}
                    </span>
                  )}
                </span>
                {data.issuer && (
                  <span class="hidden font-mono text-sm text-text-secondary sm:block">
                    {data.issuer}
                  </span>
                )}
                <ArrowLink />
              </a>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- 04 Formación -->
    <article>
      <h2 class={`${labelClass} flex items-center gap-3`}>
        <span class="text-primary dark:text-secondary">04</span>
        <span>Formación</span>
      </h2>
      <ul class="mt-4 border-t border-border" role="list">
        {
          education.map(({ data }) => (
            <li
              class={`${rowBorder} grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 py-4 sm:grid-cols-[1fr_auto_auto] sm:gap-x-8`}
            >
              <span class="text-base text-text-primary">{data.title}</span>
              <span class="col-start-1 font-mono text-xs text-text-secondary sm:col-start-auto sm:text-sm">
                {data.institution}
              </span>
              <span class="col-start-2 row-start-1 font-mono text-xs text-text-secondary sm:col-start-auto sm:row-start-auto sm:text-sm">
                {data.year}
              </span>
            </li>
          ))
        }
      </ul>
    </article>
  </main>
</section>
