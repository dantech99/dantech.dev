---
import SectionHeading from "@/components/SectionHeading.astro";
import SiteCard from "@/components/SiteCard.jsx";
import { testimonials } from "@/data/testimonials";

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

{
  testimonials.length > 0 && (
    <section
      id="testimonios"
      class="mx-auto flex w-full scroll-mt-8 flex-col gap-12 py-16"
    >
      <SectionHeading
        label="Testimonios"
        title="Lo que dicen quienes ya trabajaron conmigo"
      />
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
        {testimonials.map(({ name, role, quote, date, avatar }) => (
          <SiteCard
            client:visible
            role="figure"
            radius={16}
            padding="1rem"
            className="mb-4 break-inside-avoid"
          >
            <div class="flex items-start justify-between gap-3">
              {avatar ? (
                <img
                  src={avatar}
                  alt=""
                  class="size-9 rounded-full object-cover"
                  loading="lazy"
                />
              ) : (
                <span class="grid size-9 place-items-center rounded-full bg-soft text-xs font-medium text-ink">
                  {initials(name)}
                </span>
              )}
              {date && (
                <span class="rounded-full bg-soft px-2.5 py-1 text-[10px] uppercase tracking-wide text-ink-muted">
                  {date}
                </span>
              )}
            </div>
            <figcaption class="mt-3">
              <span class="block text-sm font-medium text-ink">{name}</span>
              <span class="block text-xs text-ink-muted">{role}</span>
            </figcaption>
            <blockquote class="mt-4 text-sm leading-relaxed text-ink">
              {quote}
            </blockquote>
          </SiteCard>
        ))}
      </div>
    </section>
  )
}
