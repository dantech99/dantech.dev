---
import { mailto } from "@/data/contact";

const corners = [
  "left-3 top-3",
  "right-3 top-3",
  "bottom-3 left-3",
  "bottom-3 right-3",
];
---

<section id="contacto" class="mx-auto w-full scroll-mt-8 py-16">
  <div
    class="relative isolate overflow-hidden rounded-3xl border border-line bg-surface px-6 py-16 text-center shadow-elevated"
  >
    <div
      class="dot-field pointer-events-none absolute inset-0 -z-10 text-ink opacity-[0.18]"
      aria-hidden="true"
    >
    </div>
    {
      corners.map((position) => (
        <span
          class={`absolute size-2.5 rounded-full border border-line bg-surface ${position}`}
          aria-hidden="true"
        />
      ))
    }

    <div class="flex flex-col items-center gap-6">
      <span
        class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-ink shadow-elevated"
      >
        Soy Danilo
      </span>
      <h2
        class="max-w-[22ch] text-balance font-serif text-[34px] leading-[1.08] tracking-[-0.02em] text-ink md:text-[44px]"
      >
        Cuéntame tu idea y hagámosla realidad.
      </h2>
      <a
        href={mailto("Proyecto web")}
        class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-on-ink transition hover:-translate-y-0.5"
      >
        Hablemos
      </a>
    </div>
  </div>
  <div
    class="mx-auto -mt-px h-3 w-[93%] rounded-b-2xl border border-t-0 border-line bg-surface/70"
    aria-hidden="true"
  >
  </div>
</section>
