---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import NextArticle from '@/components/NextArticle.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: { id: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const { data } = article;

const date =
  data.date && data.date !== '__DATE__' ? data.date : new Date().toISOString();

const { title, description, author, img } = data;
const { Content } = await article.render();

export const prerender = true;
---

<Layout title=`${title}` description={description}>
  <article class="mx-auto flex w-full flex-col gap-10 pb-16 pt-12">
    <header class="flex flex-col items-center gap-5 text-center">
      <span
        class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-ink shadow-elevated">
        Artículo
      </span>
      <h1
        class="max-w-[24ch] text-balance break-words font-serif text-[36px] leading-[1.08] tracking-[-0.02em] text-ink md:text-[52px]"
        transition:name={`article-${title}`}>
        {title}
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="rounded-full bg-soft px-3 py-1 text-ink">Por {author}</span>
        <span class="rounded-full bg-soft px-3 py-1 text-ink-muted">
          {new Date(date).toLocaleDateString()}
        </span>
      </div>
    </header>

    <img
      src={img}
      alt=""
      class="h-48 w-full rounded-2xl border border-line object-cover md:h-80"
      onerror="this.style.display='none'"
    />

    <div class="mx-auto flex w-full max-w-3xl flex-col gap-10">
      <div class="prose prose-site max-w-none text-pretty">
        <Content />
      </div>

      <a
        href="/blog"
        class="w-fit rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink shadow-elevated transition hover:-translate-y-0.5">
        ← Volver al blog
      </a>

      {data.nextSlug && <NextArticle slug={data.nextSlug} />}
    </div>
  </article>
</Layout>
